# ===========================================================================
# CCCS Announcer settings
#
# You probably do not need to change anything in this file.
# Everything has a sensible default, and the announcer finds the speech
# engine and voice by itself.
#
# To change something: copy this file to ".env" (setup.bat does that for
# you), edit the line, and restart the announcer.
#
# The full list of settings, with explanations, is in .env.example.full
# ===========================================================================


# Which port staff connect on. Only change this if 8080 is already used.
PA_PORT=8080

# Which speakers to use. Leave blank for the Windows default playback
# device, which is right on almost every install. To use a specific one,
# run show-address.bat's neighbour:
#     .venv\Scripts\python.exe scripts\list_audio_devices.py
# and put any part of the device's name here, e.g.  PA_AUDIO_DEVICE=Realtek
PA_AUDIO_DEVICE=

# How loud the chime is compared with the speech. 1.0 is full volume.
# Lower this if the chime is startling. 0.45 is a good starting point.
PA_CHIME_GAIN=0.45

# How fast the voice speaks. Higher is SLOWER.
# 1.05 is normal; try 1.15 in a big echoey hallway.
PIPER_LENGTH_SCALE=1.05


# ---------------------------------------------------------------------------
# Occasionally useful
# ---------------------------------------------------------------------------

# The sound used by anyone who has not chosen their own. Each staff member
# picks theirs when they first sign in, and can change it later from the
# announcement page.
#
# Longer, more attention-getting:
#   westminster   the four-note school clock
#   arrival       warm three-note rise, like an airport
#   fanfare       four notes climbing to a held top note
#   school_bell   five strikes of the same bell
#   double_chime  ding-dong, twice
#   xylophone     bright and bouncy
#   sunrise       a slow five-note climb
# Shorter:
#   two_tone_bell, attention, soft_alert, alarm_pattern, urgent
PA_DEFAULT_CHIME=two_tone_bell

# Longest announcement staff can send.
PA_MAX_CHARS=500

# How many announcements one staff member may send in 10 minutes.
# Administrators are never limited. Set to 0 to turn the limit off.
PA_RATE_LIMIT_COUNT=5

# Sound clips: the longest and largest a clip may be. Everything else in the
# queue waits behind a clip while it plays, so keep the limit sane.
PA_SOUND_MAX_SECONDS=300
PA_SOUND_MAX_MB=25

# The school's own timezone. Everything staff type into the schedule page is
# in this; everything stored is UTC, so scheduled announcements stay at the
# right time when the clocks change.
PA_TIMEZONE=America/Vancouver

# How late a scheduled announcement may be and still go out. Anything later
# is skipped and logged: it means the announcer was switched off, and firing a
# weekend's backlog into Monday morning is worse than missing it.
PA_SCHEDULE_GRACE_MINUTES=10

# How long a signed-in computer can sit untouched before it signs itself
# out. This is what stops an unattended staff machine being an open mic.
PA_SESSION_IDLE_MINUTES=30

# The announcer says its own address over the PA when it starts, so you can
# hear what to type from anywhere in the building.
#
#   always  every start, repeating until an administrator signs in (default)
#   setup   only on a brand-new install, until the account is set up
#   once    say it a single time at every start, no repeats
#   never   silent
#
# It ALWAYS stops the moment an administrator signs in, and always gives up
# after the number of repeats below. Worth thinking about: with "always", a
# restart in the middle of a lesson announces the address into every
# classroom until somebody signs in or it hits the limit. Use "once" for one
# announcement per restart, or "setup" for the quietest setting.
PA_ANNOUNCE_ADDRESS_ON_START=always
PA_ANNOUNCE_ADDRESS_INTERVAL_SECONDS=60
PA_ANNOUNCE_ADDRESS_MAX_TIMES=20

# Windows playback volume, set on every start so a PA machine that somebody
# once turned down cannot end up whispering. Trim loudness at the AMPLIFIER,
# not here: full digital level into a properly set amplifier is clean, while
# a quiet signal pushed up by the amplifier brings the noise up with it.
# Set to "off" to leave the Windows volume alone.
PA_SET_SYSTEM_VOLUME=100
