# ===========================================================================
# CCCS Announcer settings
#
# You probably do not need to change anything in this file.
# Everything has a sensible default, and the announcer finds the speech
# engine and voice by itself.
#
# To change something: copy this file to ".env" (setup.bat does that for
# you), edit the line, and restart the announcer.
#
# The full list of settings, with explanations, is in .env.example.full
# ===========================================================================


# Which port staff connect on. Only change this if 8080 is already used.
PA_PORT=8080

# Which speakers to use. Leave blank for the Windows default playback
# device, which is right on almost every install. To use a specific one,
# run show-address.bat's neighbour:
#     .venv\Scripts\python.exe scripts\list_audio_devices.py
# and put any part of the device's name here, e.g.  PA_AUDIO_DEVICE=Realtek
PA_AUDIO_DEVICE=

# How loud the chime is compared with the speech. 1.0 is full volume.
# Lower this if the chime is startling. 0.45 is a good starting point.
PA_CHIME_GAIN=0.45

# How fast the voice speaks. Higher is SLOWER.
# 1.05 is normal; try 1.15 in a big echoey hallway.
PIPER_LENGTH_SCALE=1.05


# ---------------------------------------------------------------------------
# Occasionally useful
# ---------------------------------------------------------------------------

# The chime played before EVERY announcement. Staff do not choose one.
# Options: two_tone_bell, attention, soft_alert, urgent
PA_DEFAULT_CHIME=two_tone_bell

# Longest announcement staff can send.
PA_MAX_CHARS=500

# How many announcements one staff member may send in 10 minutes.
# Administrators are never limited. Set to 0 to turn the limit off.
PA_RATE_LIMIT_COUNT=5

# How long a signed-in computer can sit untouched before it signs itself
# out. This is what stops an unattended staff machine being an open mic.
PA_SESSION_IDLE_MINUTES=30

# On a BRAND-NEW install only, the announcer says its own address over the
# PA so whoever is setting it up can hear what to type. It stops the moment
# somebody signs in and sets up the administrator account, and never happens
# again -- not on the next reboot, not a year later. It also gives up after
# the number of repeats below even if nobody signs in.
# Set to false if you would rather it stayed silent.
PA_ANNOUNCE_ADDRESS_ON_START=true
PA_ANNOUNCE_ADDRESS_INTERVAL_SECONDS=60
PA_ANNOUNCE_ADDRESS_MAX_TIMES=20
