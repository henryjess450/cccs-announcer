# ===========================================================================
# CCCS Announcer - EVERY setting, with explanations
#
# This is the full reference. For normal installs use .env.example instead;
# it is short, and everything here has a working default.
#
# Copy any line you want to change into your ".env" file.
# Lines starting with # are comments and are ignored.
# On Windows use full paths with backslashes, e.g. C:\announcer\piper\piper.exe
# ===========================================================================

# --- Web server ------------------------------------------------------------
# 0.0.0.0 means "listen on every network the machine is connected to", which is
# what you want so staff computers can reach it. Change PA_PORT only if 8080 is
# already used on this machine.
PA_HOST=0.0.0.0
PA_PORT=8080

# --- Where data lives ------------------------------------------------------
# Everything (database, logs, chimes) lives under PA_DATA_DIR unless you
# override an individual path. Back up this whole folder.
PA_DATA_DIR=data
# PA_DB_PATH=data\announcer.sqlite3
# PA_CHIME_DIR=data\chimes
# PA_LOG_DIR=data\logs
PA_LOG_LEVEL=INFO

# --- Speech engine ---------------------------------------------------------
# piper = offline speech, nothing leaves the building (recommended).
# mock  = a test tone instead of speech, for trying the system on a laptop.
PA_TTS_ENGINE=piper

# Where Piper is. LEAVE THESE BLANK unless you put Piper somewhere unusual:
# the announcer looks in <announcer folder>\piper\piper.exe and uses the
# voice in <announcer folder>\voices automatically, which is where setup.bat
# puts them.
# PIPER_BINARY=C:\announcer\piper\piper.exe
# PIPER_MODEL=C:\announcer\voices\en_US-lessac-medium.onnx
# Only needed if the .onnx.json is somewhere else.
# PIPER_CONFIG=C:\announcer\voices\en_US-lessac-medium.onnx.json

# Speaking rate. 1.0 is normal. Higher is SLOWER (1.15 is a good PA speed,
# because reverberant hallways swallow fast speech).
PIPER_LENGTH_SCALE=1.05
PIPER_TIMEOUT_SECONDS=30

# --- Speaker output --------------------------------------------------------
# sounddevice = the real speakers. mock = no sound at all (testing only).
PA_AUDIO_BACKEND=sounddevice

# Part of the output device name, as shown by:  python scripts\list_audio_devices.py
# Leave blank to use the Windows default playback device.
# Matched by NAME, never by number, because Windows renumbers devices on reboot.
PA_AUDIO_DEVICE=

# Leave blank to use the device's own sample rate. Only set this if you know why.
PA_AUDIO_SAMPLERATE=
PA_AUDIO_CHANNELS=2
PA_AUDIO_BLOCKSIZE=2048

# --- Levels and timing -----------------------------------------------------
# Chimes are mixed BELOW speech on purpose. 1.0 is full volume.
PA_SPEECH_GAIN=1.0
PA_CHIME_GAIN=0.45
# Silence between the chime and the first word, in milliseconds.
PA_CHIME_GAP_MS=500

# The chime played before EVERY announcement. Staff do not choose a chime --
# there is no chooser on the page, and this is the only sound that plays.
# Built in: two_tone_bell, attention, soft_alert, urgent
PA_DEFAULT_CHIME=two_tone_bell

# Short tone after the announcement. Leave blank for none.
PA_END_TONE=

# --- Accounts and sessions -------------------------------------------------
# How long a signed-in computer can sit untouched before it signs itself out.
# This is what stops an unattended staff machine being an open microphone.
PA_SESSION_IDLE_MINUTES=30
# Absolute maximum length of a session, even if it is being used constantly.
PA_SESSION_MAX_HOURS=12

# Set to true ONLY if you are serving this over HTTPS. On a plain http:// LAN
# address, "true" stops sign-in working at all, because the browser will refuse
# to send the cookie back.
PA_SESSION_COOKIE_SECURE=false

# On the very first start, with no accounts in the database, the announcer
# creates an administrator for itself so nobody needs a command line to begin.
# The username is below; the password is GENERATED, printed on screen, and
# saved to FIRST-LOGIN.txt in the data folder. Sign in with it and you are
# asked to choose your own name, username and password straight away.
#
# Leave PA_BOOTSTRAP_PASSWORD blank unless you have a reason not to. A fixed,
# known password on a machine reachable from the school network is an open
# door for as long as it takes somebody to sign in for the first time.
PA_BOOTSTRAP_USERNAME=admin
PA_BOOTSTRAP_PASSWORD=

# Wrong passwords before an account is locked, and how long the lock lasts.
# An administrator can unlock it sooner from the admin page.
PA_LOGIN_MAX_FAILURES=5
PA_LOGIN_LOCKOUT_SECONDS=300

# --- Rate limiting ---------------------------------------------------------
# How many announcements one staff member may send in the window. This is
# about stopping accidents -- a stuck key, a double-click -- not about
# stopping deliberate misuse; the audit log does that. Administrators are
# always exempt. Set the count to 0 to turn the limit off entirely.
PA_RATE_LIMIT_COUNT=5
PA_RATE_LIMIT_WINDOW_SECONDS=600

# --- Preview ---------------------------------------------------------------
# How many previews may be produced at once. Preview uses the same voice
# engine as real announcements, so this cap stops a room full of people
# previewing from slowing down something that is actually going out.
PA_PREVIEW_MAX_CONCURRENT=2

# --- Composing -------------------------------------------------------------
PA_MAX_CHARS=500
# Starting guess for how fast the voice speaks, used for "about 40 seconds".
# The system measures the real rate as it runs and corrects itself.
PA_CHARS_PER_SECOND=13.5
